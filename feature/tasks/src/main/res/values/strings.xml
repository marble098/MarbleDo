    <string name="tasks_voice_prompt_date">Say a Persian date, such as 25 Aban 1405, or tomorrow. Say skip for no date.</string>
    <string name="tasks_voice_prompt_time">Say the hour and minute, such as 14:30. Say skip for no time.</string>
