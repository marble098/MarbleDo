<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal: text only. A dot and a word for the state, no badge, no pill.
     Expanded card. Generated by scripts/generate_notification_layouts.py; edit the table there. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <ImageView
        android:id="@+id/notification_card_plate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/notification_card_plate_light" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/notification_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn_variable"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="@color/notification_card_text"
                android:textDirection="ltr"
                android:textSize="14sp"
                android:textStyle="bold" />
            <FrameLayout
                android:id="@+id/notification_state_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layoutDirection="ltr">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layoutDirection="ltr"
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/notification_state_icon"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_notification_state_dot"
                        app:tint="@color/notification_state_overdue" />
                    <TextView
                        android:id="@+id/notification_state_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="112dp"
                        android:layout_marginStart="5dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/vazirmatn_variable"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/notification_state_overdue"
                        android:textDirection="ltr"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/notification_next_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layoutDirection="ltr"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/notification_tasks_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="ltr"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/notification_tasks_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/vazirmatn_variable"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/notification_card_accent"
                        android:textDirection="ltr"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layoutDirection="ltr"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/notification_task_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/vazirmatn_variable"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:textAlignment="viewStart"
                            android:textColor="@color/notification_card_text"
                            android:textDirection="ltr"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/notification_task_meta"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/vazirmatn_variable"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textAlignment="viewStart"
                            android:textColor="@color/notification_card_muted"
                            android:textDirection="ltr"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/notification_task_second_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layoutDirection="ltr"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/notification_task_second_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/vazirmatn_variable"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textAlignment="viewStart"
                            android:textColor="@color/notification_card_text"
                            android:textDirection="ltr"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/notification_task_second_meta"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/vazirmatn_variable"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textAlignment="viewStart"
                            android:textColor="@color/notification_card_muted"
                            android:textDirection="ltr"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/notification_task_more"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/vazirmatn_variable"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/notification_card_muted"
                        android:textDirection="ltr"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/notification_occasions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/notification_occasions_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/notification_hairline_light" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layoutDirection="ltr"
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/notification_occasions_icon"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="6dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_notification_occasion_star"
                        app:tint="@color/notification_state_occasion" />
                    <TextView
                        android:id="@+id/notification_occasions_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/vazirmatn_variable"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/notification_state_occasion"
                        android:textDirection="ltr"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/notification_occasions_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/vazirmatn_variable"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textAlignment="viewStart"
                    android:textColor="@color/notification_card_muted"
                    android:textDirection="ltr"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
