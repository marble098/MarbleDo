<?xml version="1.0" encoding="utf-8"?>
<!-- Classic, expanded: the tasks, then the occasions under a hairline.
     Generated by scripts/generate_notification_layouts.py; edit the table there. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <ImageView
        android:id="@+id/notification_card_plate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/notification_card_plate_light" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:gravity="start"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/notification_badge"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layoutDirection="ltr"
                android:gravity="start"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/notification_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/vazirmatn_variable"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/notification_card_text"
                    android:textDirection="ltr"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/notification_secondary_dates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/vazirmatn_variable"
                    android:gravity="start"
                    android:maxLines="2"
                    android:textAlignment="viewStart"
                    android:textColor="@color/notification_card_muted"
                    android:textDirection="ltr"
                    android:textSize="10sp" />
                <FrameLayout
                    android:id="@+id/notification_state_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layoutDirection="ltr"
                    android:layout_marginTop="3dp"
                    android:importantForAccessibility="no">
                    <ImageView
                        android:id="@+id/notification_state_chip_plate"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/notification_state_chip" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layoutDirection="ltr"
                        android:gravity="start|center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">
                        <ImageView
                            android:id="@+id/notification_state_icon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="7dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/ic_notification_warning"
                            app:tint="@color/notification_state_overdue" />
                        <TextView
                            android:id="@+id/notification_state_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="7dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/vazirmatn_variable"
                            android:gravity="start"
                            android:maxLines="1"
                            android:textAlignment="viewStart"
                            android:textColor="@color/notification_state_overdue"
                            android:textDirection="ltr"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/notification_next_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:background="@drawable/notification_focus_background"
        >
            <ImageView
                android:id="@+id/notification_focus_plate"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">
                <LinearLayout
                    android:id="@+id/notification_tasks_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="ltr"
                    android:gravity="start"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/notification_tasks_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/vazirmatn_variable"
                        android:gravity="start"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/notification_card_accent"
                        android:textDirection="ltr"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/notification_task_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/vazirmatn_variable"
                        android:gravity="start"
                        android:lineSpacingExtra="1dp"
                        android:maxLines="4"
                        android:textAlignment="viewStart"
                        android:textColor="@color/notification_card_text"
                        android:textDirection="ltr"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/notification_task_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/vazirmatn_variable"
                        android:gravity="start"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/notification_card_muted"
                        android:textDirection="ltr"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/notification_task_second_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/vazirmatn_variable"
                        android:gravity="start"
                        android:maxLines="2"
                        android:textAlignment="viewStart"
                        android:textColor="@color/notification_card_text"
                        android:textDirection="ltr"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/notification_task_second_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/vazirmatn_variable"
                        android:gravity="start"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/notification_card_muted"
                        android:textDirection="ltr"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/notification_task_more"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/vazirmatn_variable"
                        android:gravity="start"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="@color/notification_card_muted"
                        android:textDirection="ltr"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:id="@+id/notification_occasions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:gravity="start"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/notification_occasions_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/notification_banner_bar" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="5dp">
                <ImageView
                    android:id="@+id/notification_occasions_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="5dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_notification_occasion_star"
                    app:tint="@color/notification_state_occasion" />
                <TextView
                    android:id="@+id/notification_occasions_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/vazirmatn_variable"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/notification_state_occasion"
                    android:textDirection="ltr"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/notification_occasions_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn_variable"
                android:gravity="start"
                android:maxLines="3"
                android:textAlignment="viewStart"
                android:textColor="@color/notification_card_muted"
                android:textDirection="ltr"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
