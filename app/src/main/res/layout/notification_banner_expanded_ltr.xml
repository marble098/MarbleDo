<?xml version="1.0" encoding="utf-8"?>
<!--
  Banner (expanded): a single tinted hero block carries the badge, the date and the mood. Under it
  the progress, the next task and the occasions are flat rows separated by hairlines, so nothing
  competes with the hero for attention.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:background="@drawable/notification_banner_header"
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">
        <!--
          The day's mood rule. CalendarNotificationViews tints this id for every banner layout it
          builds, collapsed or expanded; a missing id makes the whole RemoteViews fail to apply and
          the notification disappears from the status bar, so the expanded hero carries it too.
        -->
        <View
            android:id="@+id/notification_accent_rule"
            android:layout_width="4dp"
            android:layout_height="34dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/notification_banner_bar"
            android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/notification_badge"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layoutDirection="ltr"
            android:gravity="start"
            android:orientation="vertical">
            <TextView
                android:id="@+id/notification_mood_pill"
                style="@style/TextAppearance.Compat.Notification.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="@color/notification_card_accent"
                android:textDirection="ltr"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/notification_title"
                style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textDirection="ltr"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/notification_secondary_dates"
                style="@style/TextAppearance.Compat.Notification.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:textDirection="ltr"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/notification_progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:layout_marginTop="10dp"
        android:gravity="start"
        android:orientation="vertical">
        <TextView
            android:id="@+id/notification_progress_label"
            style="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textDirection="ltr"
            android:textSize="11sp" />
        <ProgressBar
            android:id="@+id/notification_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layoutDirection="ltr"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:progressBackgroundTint="@color/notification_card_track"
            android:progressTint="@color/notification_card_accent" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/notification_card_track"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:id="@+id/notification_next_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:layout_marginTop="8dp"
        android:gravity="start"
        android:orientation="vertical">
        <TextView
            android:id="@+id/notification_next_label"
            style="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/notification_card_accent"
            android:textDirection="ltr"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/notification_next_title"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:textDirection="ltr"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/notification_next_time"
            style="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textDirection="ltr"
            android:textSize="11sp" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/notification_card_track"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:id="@+id/notification_occasions_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:layout_marginTop="8dp"
        android:gravity="start"
        android:orientation="vertical">
        <TextView
            android:id="@+id/notification_occasions_label"
            style="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/notification_card_accent"
            android:textDirection="ltr"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/notification_occasions_text"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="3"
            android:textAlignment="viewStart"
            android:textDirection="ltr"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/notification_more_occasions"
            style="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textDirection="ltr"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
