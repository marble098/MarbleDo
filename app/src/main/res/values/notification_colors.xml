<resources>
    <!-- Fallback colours for the notification layouts. A custom RemoteViews layout inherits
         SystemUI's text colour, which is invisible in one of the two themes, so every text states
         a colour here — but the builder (CalendarNotificationViews) restates all of them from the
         NotificationPalette of the *app* theme at paint time. Nothing on the card depends on
         these values; they only keep the layout readable if a palette action is ever dropped. -->
    <color name="notification_card_text">#1C1B22</color>
    <color name="notification_card_muted">#5A5A6B</color>
    <color name="notification_card_accent">#4355A5</color>

    <!-- The two semantic states that keep their own hue (the third, "today", is the accent). -->
    <color name="notification_state_overdue">#B02A12</color>
    <color name="notification_state_occasion">#5B3F94</color>
</resources>
