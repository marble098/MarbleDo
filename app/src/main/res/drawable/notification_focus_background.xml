<?xml version="1.0" encoding="utf-8"?>
<!-- The one filled surface of the notification: the next step. Rounded and quiet, not a poster.
     Radius 14dp keeps it concentric inside the outer 20dp plate with 12dp padding,
     so the inner corners don't fight the outer card's rounded outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/notification_card_section" />
    <corners android:radius="14dp" />
</shape>
