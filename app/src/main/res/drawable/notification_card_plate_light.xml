<?xml version="1.0" encoding="utf-8"?>
<!--
  The card plate, light variant. Painted by the builder with setImageViewResource, chosen from the
  *app* theme's lightness rather than the device's, so a pinned dark theme keeps a dark card inside
  a light shade and vice versa.

  The two colours are written out here on purpose. A `@color/...` reference would re-resolve against
  the *night* configuration, which is exactly the system setting this plate exists to ignore; the
  literal keeps the "light plate" and "dark plate" fixed and lets the builder pick.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#F2F1F6" />
    <stroke android:width="1dp" android:color="#1C1B221A" />
    <corners android:radius="20dp" />
</shape>
