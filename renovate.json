{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["gradle", "github-actions"],
  "ignorePaths": ["gradle/wrapper/gradle-wrapper.properties"],
  "ignoreUnstable": false,
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchManagers": ["gradle"],
      "groupName": "AndroidX and Compose updates",
      "matchPackageNames": ["androidx.**"]
    },
    {
      "matchManagers": ["gradle"],
      "groupName": "Kotlin ecosystem updates",
      "matchPackageNames": ["org.jetbrains.kotlin{,.*}", "org.jetbrains.kotlinx{,.*}"]
    }
  ]
}
